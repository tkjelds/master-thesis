FROM ubuntu:24.04

ARG CODEQL_VERSION=2.27.1
ARG CODEQL_BUNDLE_SHA256=7b6bde03f722503199b3f937548caa48c09f252323d96bfbc2acce974bf8b6db

RUN apt-get update \
    && apt-get install --no-install-recommends -y \
        ca-certificates \
        curl \
        openjdk-21-jdk-headless \
        zstd \
    && curl --fail --location --silent --show-error \
        "https://github.com/github/codeql-action/releases/download/codeql-bundle-v${CODEQL_VERSION}/codeql-bundle-java-linux64.tar.zst" \
        --output /tmp/codeql-bundle.tar.zst \
    && printf '%s  %s\n' "$CODEQL_BUNDLE_SHA256" /tmp/codeql-bundle.tar.zst \
        | sha256sum --check --status \
    && mkdir -p /opt/codeql \
    && tar --zstd -xf /tmp/codeql-bundle.tar.zst -C /opt/codeql \
    && rm /tmp/codeql-bundle.tar.zst \
    && rm -rf /var/lib/apt/lists/*

ENTRYPOINT ["/opt/codeql/codeql/codeql"]
